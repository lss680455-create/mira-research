{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "thesis-card.schema.json",
  "title": "Mira Thesis Card",
  "description": "论点卡片契约：一个研究对象当前论点的最小可维护单元。回答『论点是什么、靠哪些证据、何时失效、什么会证伪它、什么时候必须刷新』。校验由 mira validate 执行（draft-07 子集：type/enum/const/required/properties/items/minItems/minLength/pattern/format/allOf/if-then/$ref）。",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "thesis_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
    "title": { "type": "string", "minLength": 1 },
    "research_object": { "type": "string", "minLength": 1 },
    "market_scope": { "type": "string", "minLength": 1 },
    "horizon": { "$ref": "vocab.json#/horizon" },
    "state": { "$ref": "vocab.json#/thesis_state" },
    "confidence": { "$ref": "vocab.json#/confidence" },
    "core_claim": { "type": "string", "minLength": 1 },
    "variant_view": { "type": "string", "minLength": 1 },
    "key_variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "variable": { "type": "string", "minLength": 1 },
          "consensus_proxy": { "type": "string", "minLength": 1 },
          "mira_view": { "type": "string", "minLength": 1 },
          "price_in_status": { "$ref": "vocab.json#/price_in_status" },
          "next_check": { "type": "string", "minLength": 1 }
        },
        "required": ["variable", "consensus_proxy", "mira_view", "price_in_status"]
      }
    },
    "key_assumptions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "disconfirming_evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "refresh": {
      "type": "object",
      "properties": {
        "stale_after": { "type": "string", "format": "date" },
        "must_refresh_if": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": ["stale_after", "must_refresh_if"]
    },
    "last_reviewed_at": { "type": "string", "format": "date" },
    "notes": { "type": "string" }
  },
  "required": [
    "schema_version",
    "thesis_id",
    "title",
    "research_object",
    "market_scope",
    "horizon",
    "state",
    "core_claim",
    "key_variables",
    "key_assumptions",
    "evidence_ids",
    "disconfirming_evidence",
    "refresh"
  ],
  "allOf": [
    {
      "$comment": "反证纪律：active/watch 系状态必须给出明确的反证路径（disconfirming_evidence 非空）。",
      "if": { "properties": { "state": { "enum": ["active", "watch", "upgrade_watch", "downgrade_watch", "narrative_watch"] } }, "required": ["state"] },
      "then": { "properties": { "disconfirming_evidence": { "minItems": 1 } } }
    },
    {
      "$comment": "stale 状态必须用 notes 说明过期原因与恢复动作，不允许静默挂着。",
      "if": { "properties": { "state": { "const": "stale" } }, "required": ["state"] },
      "then": { "required": ["notes"] }
    },
    {
      "$comment": "confidence=high 需要至少 3 条证据引用（证据不足时降级判断）。",
      "if": { "properties": { "confidence": { "const": "high" } }, "required": ["confidence"] },
      "then": { "properties": { "evidence_ids": { "minItems": 3 } } }
    },
    {
      "$comment": "状态机纪律：retired 论点必须写明 last_reviewed_at，保证退役动作有时点。",
      "if": { "properties": { "state": { "const": "retired" } }, "required": ["state"] },
      "then": { "required": ["last_reviewed_at"] }
    }
  ]
}
