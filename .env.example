# Mira 环境变量示例（复制为 .env 并按需填写；全部为可选项）
# 说明：所有变量均为「覆盖默认值」，不填也能完整离线运行。

# 显式 as-of 日期（YYYY-MM-DD）。留空 = 取运行当天。
MIRA_AS_OF=2026-09-10

# stale_after 距今 <= N 天 → due_soon
MIRA_DUE_SOON_DAYS=30

# `mira refresh` 默认使用的证据日志（相对仓库根）
MIRA_EVIDENCE_LOG=examples/aapl-2026-04/evidence-log.csv

# 配置文件路径（默认 configs/default.yaml）
# MIRA_CONFIG=configs/default.yaml
